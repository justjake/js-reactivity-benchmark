{
  "name": "js-reactivity-benchmark-node",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/isolated.ts --bundle --format=esm --platform=node --target=esnext --outdir=dist --sourcemap=external",
    "run": "node dist/index.js",
    "bench-isolated": "pnpm build && node dist/isolated.js"
  },
  "dependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.1",
    "js-reactivity-benchmark": "workspace:*"
  },
  "packageManager": "pnpm@10.14.0"
}
